# flipping-engine has no secrets. This file exists to say so explicitly, and to
# document the two things that are worth setting.

# The OSRS Wiki real-time prices API requires a DESCRIPTIVE User-Agent with a
# way to contact you; generic agents are blocked. Set your own before running
# ingest against the live API.
#   https://oldschool.runescape.wiki/w/RuneScape:Real-time_Prices
FLIPPING_USER_AGENT=

# Where the SQLite snapshot database lives. Defaults to ./prices.db.
# Ingest is append-only and unbounded, so put it somewhere with room.
FLIPPING_DB_PATH=
